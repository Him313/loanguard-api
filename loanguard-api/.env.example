# ==============================================================================
# LoanGuard API - Environment Configuration Template
# Copy this file to '.env' and update values as needed for local development.
# ==============================================================================

# Application Settings
PROJECT_NAME="LoanGuard API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (Placeholder)
DATABASE_URL="sqlite:///./loanguard.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/loanguard_db"

# Fraud Risk Assessment Thresholds (Placeholder)
FRAUD_RISK_THRESHOLD_HIGH=0.75
FRAUD_RISK_THRESHOLD_MEDIUM=0.40

# Security (Placeholder for future authentication/tokens)
SECRET_KEY="placeholder-change-this-in-production"

